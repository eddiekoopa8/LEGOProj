					<max_bounces sid="max_bounces" type="int">1024</max_bounces>
					<samples sid="samples" type="int">1</samples>
				</technique>
			</extra>
		</node>
	</visual_scene>
</library_visual_scenes>
<scene>
	<instance_visual_scene url="#VisualScene1" />
</scene>
</COLLADA>
